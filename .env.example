# Postgres. Locally: createdb platform (see README).
DATABASE_URL=postgres://platform:platform@localhost:5432/platform

# Where the API listens and where the web app is served from.
PORT=8787
WEB_ORIGIN=http://localhost:5173

# Sending. "log" keeps every email in the database without sending; "ses" sends through Amazon SES.
TRANSPORT=log
AWS_REGION=eu-west-2
SES_CONFIGURATION_SET=platform-events
# Emails a second the SES account allows (see "Sending limits" in the SES console). Campaigns pace to it.
SES_SEND_RATE=10

# The address used when a tenant has no verified domain yet.
DEFAULT_FROM=hello@example.com

# Signs sign-in cookies. Any long random string; required in production.
AUTH_SECRET=
