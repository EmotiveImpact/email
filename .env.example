# Postgres. Locally: createdb platform (see README).
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
# Neon in production: DATABASE_URL is the pooled address (host has -pooler), DIRECT_DATABASE_URL the
# direct one. Migrations need the direct one because they hold a lock for the whole run.
DIRECT_DATABASE_URL=
# Apply migrations when the server starts (production containers set true).
MIGRATE_ON_START=false
# all = API and job worker in one process; web = API only; worker = jobs only. Same image for each.
ROLE=all

# Where the API listens and where the web app is served from.
PORT=8787
WEB_ORIGIN=http://localhost:5173
# Where links in emails (unsubscribe, pictures, tracking) point. In production, the app's own address.
PUBLIC_URL=http://localhost:8787
# Production only: the built web app. The Docker image sets it; the server serves the app from it.
WEB_DIST=

# Sending. "log" keeps every email in the database without sending; "ses" sends through Amazon SES.
TRANSPORT=log
AWS_REGION=eu-west-2
SES_CONFIGURATION_SET=platform-events
# Emails a second the SES account allows (see "Sending limits" in the SES console). Campaigns pace to it.
SES_SEND_RATE=10
# Lets each business's domain be linked to its own SES tenant.
AWS_ACCOUNT_ID=
# With TRANSPORT=ses, businesses can only send from domains they have verified. Set false to relax.
VERIFIED_DOMAINS_ONLY=true

# The address used when a tenant has no verified domain yet.
DEFAULT_FROM=hello@example.com

# Signs unsubscribe links and studio sessions. Any long random string; required in production.
SIGNING_SECRET=
# SES delivery events arrive by SNS at /ses/events; only this topic is accepted.
SES_TOPIC_ARN=

# Signs sign-in cookies. Any long random string; required in production.
AUTH_SECRET=

# Pictures. Without a bucket, files are kept in Postgres and served by the API at /a/…
# With one, they go to S3 and inboxes load them from ASSETS_PUBLIC_URL (CloudFront, or the bucket).
ASSETS_BUCKET=
ASSETS_PUBLIC_URL=
# Image generation. Without a key, the app makes soft sample pictures from the brand colours.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
# Generated pictures each business may make a day.
IMAGES_PER_DAY=40

# Payments (Stripe). Without these, plans switch for free locally and cannot change in production.
# Create the plans once with `pnpm --filter @platform/api stripe:setup`, then point a webhook at
# https://<api>/billing/stripe for checkout.session.completed and customer.subscription.* events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
