{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@platform/db": "workspace:*",
    "@platform/engine": "workspace:*",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "standardwebhooks": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
